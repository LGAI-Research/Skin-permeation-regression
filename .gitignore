# This repository is a self-contained reproduction package. Everything needed to run the
# four stages is tracked; only generated artifacts are excluded.

# --- Generated by the pipeline stages. Regenerated on every run, never committed. ---
/outputs/final/
/outputs/intermediate/
/reports/
/_regen/
/runs/

# --- Maintainer-only inputs, distributed separately. ---
/reference/

# --- Transient ---
__pycache__/
*.pyc
*.log
*.joblib
